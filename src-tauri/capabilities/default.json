{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "**"
        }
      ]
    },
    "shell:default",
    "shell:allow-open",
    "dialog:default",
    "fs:allow-read-text-file",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "/var/folders/**"
        },
        {
          "path": "/tmp/**"
        },
        {
          "path": "/private/var/folders/**"
        },
        {
          "path": "**"
        }
      ]
    }
  ]
}