{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodeForge",
  "version": "25.0.0",
  "identifier": "org.devlive.codeforge",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CodeForge",
        "width": 1800,
        "height": 1200,
        "additionalBrowserArgs": "--disable-context-menu"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
