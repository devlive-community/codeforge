{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodeForge",
  "version": "26.4.0",
  "identifier": "org.devlive.codeforge",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CodeForge",
        "minWidth": 1000,
        "minHeight": 600,
        "width": 1280,
        "height": 800,
        "center": true,
        "devtools": true,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-context-menu"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/.codeforge/custom-icons/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "src/examples/*"
    ]
  }
}
